+private actor SearchCaptureSemanticService: SemanticSearchServing {
+    private static let descriptor = SemanticModelDescriptor(modelID: "controlled-ui-fixture", sourceRevision: "fixture-v1", releaseID: "fixture-v1", dimension: 2, maximumTextTokens: 64, tokenizerVersion: "v1", preprocessingVersion: 1, normalizationVersion: 1)
+    private var session = UUID(), generation = -1, version: UInt64 = 1
+    private let index = UUID()
+    private var missing = false, indexing = false, scopeCount = 3
+    private var continuation: AsyncStream<SemanticSearchState>.Continuation?
+    private(set) var prepareCalls = 0
+    func updateCatalog(snapshotSessionID: UUID, generation: Int, assets: [PhotoAsset]) { session = snapshotSessionID; self.generation = generation }
+    func search(query: String, candidates: [PhotoAsset], topK: Int) throws -> SemanticSearchResult {
+        if missing { throw SemanticEmbeddingError.unavailable(.modelNotInstalled) }
+        return .init(catalogSessionID: session, catalogGeneration: generation, indexGenerationID: index,
+            modelDescriptor: Self.descriptor, candidateAssetIDs: candidates.map(\.id),
+            hits: candidates.prefix(topK).enumerated().map { .init(assetID: $0.element.id, score: 0.88 - Float($0.offset) * 0.1) })
+    }
+    func search(similarTo reference: PhotoAsset, candidates: [PhotoAsset], topK: Int) throws -> SemanticSearchResult {
+        let result = try search(query: "reference", candidates: candidates.filter { $0.id != reference.id }, topK: topK)
+        return .init(catalogSessionID: session, catalogGeneration: generation, indexGenerationID: index, modelDescriptor: Self.descriptor,
+            candidateAssetIDs: candidates.map(\.id), hits: result.hits)
+    }
+    func status(scope: [PhotoAsset]) -> SemanticSearchState { scopeCount = scope.count; return state }
+    private var state: SemanticSearchState { .init(version: version, availability: missing ? .unavailable(.modelNotInstalled) : .available,
+        indexGenerationID: missing ? nil : index, indexedCount: indexing ? 1 : scopeCount, totalCount: scopeCount, staleCount: 0,
+        missingCount: indexing ? max(0, scopeCount - 1) : 0, processedCount: indexing ? 1 : 0, isIndexing: indexing,
+        notice: indexing ? "Kontrollierter Testzustand" : nil, modelDescriptor: missing ? nil : Self.descriptor, installedBytes: missing ? nil : 100) }
+    func updates() -> AsyncStream<SemanticSearchState> { AsyncStream { continuation = $0 } }
+    func setMissing() { missing = true; version += 1; continuation?.yield(state) }
+    func setReady() { missing = false; version += 1; continuation?.yield(state) }
+    func prepareIndex(scope: [PhotoAsset], rebuild: Bool) async throws {
+        prepareCalls += 1; scopeCount = scope.count; indexing = true; version += 1; continuation?.yield(state)
+        defer { indexing = false; version += 1; continuation?.yield(state) }
+        while indexing { try await Task.sleep(for: .milliseconds(50)) }
+    }
+    func cancelIndexing() { indexing = false; version += 1; continuation?.yield(state) }
+    func deleteIndex() {}
+    func inspectModel(source: URL) throws -> SemanticModelImportReview { throw CancellationError() }
+    func installModel(_ review: SemanticModelImportReview) {}
+    func removeModel() {}
+    func shutdown() { continuation?.finish() }
+}
