+@MainActor
+private final class ClarityCaptureHost {
+    let window: NSWindow
+    private let hosting = NSHostingView(rootView: AnyView(EmptyView()))
+    private let size: NSSize
+    var elements: [WorkspaceAccessibilityElement] { WorkspaceAccessibilityElement.descendants(of: hosting) }
+    var contentSize: NSSize { hosting.bounds.size }
+    var scaleFactor: CGFloat { window.backingScaleFactor }
+    init(size: NSSize) {
+        self.size = size
+        _ = NSApplication.shared; WorkspaceAccessibilityElement.enableInProcess()
+        hosting.sizingOptions = []
+        window = NSWindow(contentRect: NSRect(origin: NSPoint(x: -10_000, y: -10_000), size: size), styleMask: .borderless, backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false; window.ignoresMouseEvents = true
+        window.appearance = NSAppearance(named: .darkAqua); window.contentView = hosting; window.orderBack(nil)
+    }
+    func mount(_ view: some View) async throws {
+        hosting.rootView = AnyView(view.id(UUID()))
+        window.setContentSize(size); hosting.frame = NSRect(origin: .zero, size: size)
+        try await settle()
+    }
+    func settle() async throws {
+        hosting.layoutSubtreeIfNeeded(); try await Task.sleep(for: .milliseconds(250))
+        hosting.layoutSubtreeIfNeeded(); hosting.displayIfNeeded()
+    }
+    func snapshot(to url: URL) throws {
+        let bitmap = try #require(hosting.bitmapImageRepForCachingDisplay(in: hosting.bounds))
+        hosting.cacheDisplay(in: hosting.bounds, to: bitmap)
+        try #require(bitmap.representation(using: .png, properties: [:])).write(to: url)
+    }
+    func press(identifier: String? = nil, label: String? = nil) async throws {
+        try await settle()
+        let element = try #require(elements.first { (identifier != nil && $0.accessibilityIdentifier() == identifier) || (label != nil && $0.accessibilityLabel() == label) }, "Missing \(identifier ?? label ?? "action")")
+        try #require(element.isAccessibilityEnabled()); try #require(element.accessibilityPerformPress())
+        try await settle()
+    }
+    func requireHorizontallyVisible(_ element: WorkspaceAccessibilityElement) throws {
+        let frame = window.convertFromScreen(element.accessibilityFrame())
+        #expect(frame.width > 0 && frame.minX >= -1 && frame.maxX <= size.width + 1,
+            "\(element.accessibilityLabel() ?? "Action") must fit horizontally: \(frame)")
+    }
+    func requireFullyVisible(_ element: WorkspaceAccessibilityElement) throws {
+        let frame = window.convertFromScreen(element.accessibilityFrame())
+        #expect(frame.width > 0 && frame.height > 0 && frame.minX >= -1 && frame.maxX <= size.width + 1
+            && frame.minY >= -1 && frame.maxY <= size.height + 1,
+            "\(element.accessibilityLabel() ?? element.accessibilityValue() as? String ?? "Element") must fit fully: \(frame)")
+    }
+    func reveal(identifier: String) async throws {
+        window.makeFirstResponder(nil); try await settle()
+        // A form replacement or production ScrollViewReader reveal can leave
+        // the first virtual AX frame stale. Refetch after every native scroll;
+        // never publish an action capture from that first frame alone.
+        for attempt in 0..<12 {
+            let target = try #require(action(identifier: identifier))
+            let owner = try #require(owningScrollView(identifier: identifier, target: target))
+            if isVisible(target, in: owner) {
+                try await settle()
+                if let fresh = action(identifier: identifier), isVisible(fresh, in: owner) { return }
+            }
+            let document = try #require(owner.documentView)
+            let minimum = document.bounds.minY
+            let maximum = max(minimum, document.bounds.maxY - owner.contentView.bounds.height)
+            let targetFrame = window.convertFromScreen(target.accessibilityFrame())
+            let y: CGFloat
+            if attempt.isMultiple(of: 2), targetFrame.width > 0, targetFrame.height > 0 {
+                let rect = document.convert(targetFrame, from: nil)
+                y = min(maximum, max(minimum, rect.midY - owner.contentView.bounds.height / 2))
+            } else {
+                // Materialize offscreen AX nodes if their reported geometry
+                // was empty/stale. Six bounded samples cover this short form.
+                let progress = CGFloat(attempt / 2) / 5
+                y = document.isFlipped ? minimum + (maximum - minimum) * progress
+                    : maximum - (maximum - minimum) * progress
+            }
+            owner.contentView.scroll(to: CGPoint(x: owner.contentView.bounds.minX, y: y))
+            owner.reflectScrolledClipView(owner.contentView)
+            try await settle()
+        }
+        try requireVisibleAction(identifier: identifier)
+    }
+    func requireVisibleAction(identifier: String, companion: String? = nil) throws {
+        let target = try #require(action(identifier: identifier))
+        let owner = try #require(owningScrollView(identifier: identifier, target: target))
+        try #require(isVisible(target, in: owner), "\(identifier) must fit inside its scroll viewport and host before capture")
+        if let companion {
+            try #require(elements.contains {
+                ($0.accessibilityLabel() == companion || $0.accessibilityTitle() == companion)
+                    && isVisible($0, in: owner)
+            }, "\(companion) must share the visible action row")
+        }
+    }
+    private func action(identifier: String) -> WorkspaceAccessibilityElement? {
+        let matches = elements.filter { $0.accessibilityIdentifier() == identifier }
+        return matches.first { $0.isAccessibilityEnabled() } ?? matches.first
+    }
+    private func owningScrollView(identifier: String, target: WorkspaceAccessibilityElement) -> NSScrollView? {
+        let anchorID = identifier.hasPrefix("metadata.") ? "metadata.form" : "ai-development.panel"
+        let anchor = elements.first { $0.accessibilityIdentifier() == anchorID } ?? target
+        let anchorFrame = window.convertFromScreen(anchor.accessibilityFrame())
+        var pending: [NSView] = [hosting], candidates: [NSScrollView] = []
+        while let next = pending.popLast() {
+            pending.append(contentsOf: next.subviews)
+            guard let scroll = next as? NSScrollView, let document = scroll.documentView,
+                  document.bounds.height > scroll.contentView.bounds.height + 1 else { continue }
+            let viewport = scroll.contentView.convert(scroll.contentView.bounds, to: nil)
+            if anchorFrame.midX >= viewport.minX && anchorFrame.midX <= viewport.maxX { candidates.append(scroll) }
+        }
+        // Exclude nested text editors by preferring the full column viewport.
+        return candidates.max { $0.contentView.bounds.width < $1.contentView.bounds.width }
+    }
+    private func isVisible(_ element: WorkspaceAccessibilityElement, in owner: NSScrollView) -> Bool {
+        let frame = window.convertFromScreen(element.accessibilityFrame())
+        let viewport = owner.contentView.convert(owner.contentView.bounds, to: nil)
+        let host = hosting.convert(hosting.bounds, to: nil)
+        return frame.width > 0 && frame.height > 0
+            && viewport.insetBy(dx: -1, dy: -1).contains(frame) && host.insetBy(dx: -1, dy: -1).contains(frame)
+    }
+    func close() { hosting.rootView = AnyView(EmptyView()); window.close() }
