+private actor ClarityCaptureSearchService: SemanticSearchServing {
+    private var session = UUID(), generation = 0, missing = true
+    private var version: UInt64 = 1
+    private var continuation: AsyncStream<SemanticSearchState>.Continuation?
+    private(set) var prepareCalls = 0
+    private static let descriptor = SemanticModelDescriptor(modelID: "controlled-ui-fixture", sourceRevision: "fixture-v1", releaseID: "fixture-v1", dimension: 2, maximumTextTokens: 64, tokenizerVersion: "v1", preprocessingVersion: 1, normalizationVersion: 1)
+    func updateCatalog(snapshotSessionID: UUID, generation: Int, assets: [PhotoAsset]) { session = snapshotSessionID; self.generation = generation }
+    func status(scope: [PhotoAsset]) -> SemanticSearchState {
+        .init(version: version, availability: missing ? .unavailable(.modelNotInstalled) : .available, indexGenerationID: nil,
+            indexedCount: 0, totalCount: scope.count, staleCount: 0, missingCount: scope.count,
+            processedCount: 0, isIndexing: false, notice: nil,
+            modelDescriptor: missing ? nil : Self.descriptor)
+    }
+    func updates() -> AsyncStream<SemanticSearchState> { AsyncStream { continuation = $0 } }
+    func setMissing() { missing = true; version += 1 }
+    func setReady() { missing = false; version += 1 }
+    func search(query: String, candidates: [PhotoAsset], topK: Int) throws -> SemanticSearchResult { throw CaptureError() }
+    func search(similarTo reference: PhotoAsset, candidates: [PhotoAsset], topK: Int) throws -> SemanticSearchResult { throw CaptureError() }
+    func prepareIndex(scope: [PhotoAsset], rebuild: Bool) throws { prepareCalls += 1; throw SemanticEmbeddingError.indexUnavailable }
+    func cancelIndexing() {}
+    func deleteIndex() {}
+    func inspectModel(source: URL) throws -> SemanticModelImportReview { throw CancellationError() }
+    func installModel(_ review: SemanticModelImportReview) {}
+    func removeModel() {}
+    func shutdown() { continuation?.finish() }
+    private struct CaptureError: LocalizedError {
+        var errorDescription: String? { "Kontrollierter Testfehler: Suchindex konnte nicht geschrieben werden." }
+    }
+}
