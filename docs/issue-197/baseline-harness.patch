+/// Production tool views and rendering, mounted in an isolated native host.
+/// AppKit state is shared, so window cases stay ordered; rendering runs off MainActor.
+@Suite("Unified repair native acceptance", .serialized, .timeLimit(.minutes(3)))
+@MainActor
+struct DevelopRepairScreenshotTests {
+    @Test(.enabled(if: ProcessInfo.processInfo.environment["GLOWROOM_197_SNAPSHOTS"] != nil),
+          arguments: [NSSize(width: 1_440, height: 900), NSSize(width: 1_000, height: 660)])
+    func repairStates(size: NSSize) async throws {
+        let baseline = ProcessInfo.processInfo.environment["GLOWROOM_197_BASELINE"] == "1"
+        let prefix = baseline ? "before" : "after"
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("Glowroom-RepairAcceptance-\(UUID())")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let bitmap = PreviewBitmap(image: try image())
+        let url = directory.appendingPathComponent("Retusche.png")
+        let destination = try #require(CGImageDestinationCreateWithURL(url as CFURL, UTType.png.identifier as CFString, 1, nil))
+        CGImageDestinationAddImage(destination, bitmap.image, nil)
+        try #require(CGImageDestinationFinalize(destination))
+        let bytes = try Data(contentsOf: url)
+        let asset = PhotoAsset(folderID: UUID(), fileURL: url, fileSize: Int64(bytes.count), pixelWidth: 900, pixelHeight: 600)
+        let editor = EditingModel(directory: directory.appendingPathComponent("Editing"))
+        try await wait { !editor.isLoading }
+        let candidates = try dustCandidates()
+        var services = DevelopRepairServices.live
+        // Controlled detection isolates the review UI; no model result is invented.
+        services.candidates = { _, _, _ in candidates }
+        services.source = { _, _, _, _ in try LocalMaskPoint(x: 0.24, y: 0.35) }
+        let workspace = DevelopWorkspace(repairServices: services,
+            repairAIStore: DevelopRepairAIModelStore(directory: directory.appendingPathComponent("MissingModel")))
+        let source = AISourceIdentity.original(.init(fileURL: url, modifiedAt: asset.modifiedAt, fileSize: asset.fileSize))
+        workspace.bind(source: source); workspace.tool = .repair
+        workspace.receive(bitmap, sourceBitmap: bitmap); workspace.markDisplayed(source: source, settings: .newEditingSettings)
+        let host = RepairAcceptanceHost(size: size)
+        defer { host.close(); workspace.clear() }
+        func mount() async throws {
+            let settings = editor.settings(for: asset.id)
+            let rendered = try await Task.detached(priority: .userInitiated) { try EditRenderer.render(bitmap, settings: settings) }.value
+            workspace.receive(rendered, sourceBitmap: bitmap); workspace.markDisplayed(source: source, settings: settings)
+            try await host.mount(RepairAcceptanceView(asset: asset, workspace: workspace, bitmap: rendered, size: size).environmentObject(editor))
+        }
+        func capture(_ name: String, evidence: String = "production views; synthetic fixture; no model inference") async throws {
+            try await host.settle()
+            let output = URL(fileURLWithPath: ProcessInfo.processInfo.environment["GLOWROOM_197_SNAPSHOTS"]!, isDirectory: true)
+            try FileManager.default.createDirectory(at: output, withIntermediateDirectories: true)
+            let png = output.appendingPathComponent("\(prefix)-\(name)-\(Int(size.width)).png")
+            try host.snapshot(to: png)
+            let encoder = JSONEncoder(); encoder.outputFormatting = .sortedKeys
+            let record: [String: Any] = ["state": name, "windowWidthPoints": size.width, "windowHeightPoints": size.height,
+                "panelWidthPoints": 340, "sourceCommit": ProcessInfo.processInfo.environment["GLOWROOM_WORKSPACE_SNAPSHOT_COMMIT"] ?? "working-tree",
+                "host": "isolated native DevelopGeometryInspector and DevelopCanvasInteraction over EditRenderer output",
+                "fixture": "synthetic still life, generated by DevelopRepairScreenshotTests", "fixtureSHA256": digest(bytes),
+                "settingsSHA256": digest(try encoder.encode(editor.settings(for: asset.id))),
+                "screenshotSHA256": digest(try Data(contentsOf: png)), "evidence": evidence,
+                "modelAvailable": workspace.repairAIReady, "candidateCount": workspace.repairCandidates.count,
+                "selectedCandidateCount": workspace.repairSelectedCandidateIDs.count,
+                "retouchCount": editor.settings(for: asset.id).developGeometry.retouchStrokes.count,
+                "redEyeCount": editor.settings(for: asset.id).developGeometry.redEyeCorrections.count,
+                "macOS": ProcessInfo.processInfo.operatingSystemVersionString]
+            try JSONSerialization.data(withJSONObject: record, options: [.prettyPrinted, .sortedKeys])
+                .write(to: png.deletingPathExtension().appendingPathExtension("json"))
+        }
+        try await mount()
+        try await workspace.refreshRepairAIAvailability()
+        #expect(!workspace.repairAIReady)
+        try await capture("remove-missing-model")
+        try await host.reveal(identifier: "develop.repair.detect-dust")
+        try await capture("detection-actions")
+        if baseline { #expect(await editor.finishSaving()); return }
+
+        try await host.press("develop.repair.mode.clone")
+        workspace.repairSource = try LocalMaskPoint(x: 0.24, y: 0.35)
+        workspace.repairRadius = 0.06
+        let target = try LocalMaskPoint(x: 0.58, y: 0.35)
+        workspace.applyRepair(path: [target], asset: asset, editor: editor,
+            expectedRevision: editor.localRevision(for: asset.id), expectedSession: editor.aiEditSessionID)
+        await workspace.repairTask?.value
+        let clone = try #require(editor.settings(for: asset.id).developGeometry.retouchStrokes.first)
+        workspace.repairSelectedStrokeID = clone.id
+        try await mount()
+        try await capture("clone-source-target")
+        editor.undo(assetID: asset.id)
+        #expect(editor.settings(for: asset.id).developGeometry.retouchStrokes.isEmpty)
+        editor.redo(assetID: asset.id)
+        #expect(editor.settings(for: asset.id).developGeometry.retouchStrokes == [clone])
+        editor.undo(assetID: asset.id)
+        try await mount()
+
+        try await host.press("develop.repair.mode.remove")
+        await workspace.detectRepairCandidates(.dust)
+        // Detection is explicitly controlled above; the same real list, mask and action are used.
+        try await wait { workspace.repairCandidates.count == 2 }
+        workspace.repairSelectedCandidateIDs = [candidates[0].id]
+        try await host.settle()
+        try await host.reveal(identifier: "develop.repair.remove-selected")
+        #expect(editor.settings(for: asset.id).developGeometry.retouchStrokes.isEmpty)
+        try await capture("dust-candidates", evidence: "two injected synthetic dust candidates; one selected; photo unchanged; no detection/model inference")
+        await workspace.removeSelectedRepairCandidates(asset: asset, editor: editor)
+        #expect(editor.settings(for: asset.id).developGeometry.retouchStrokes.count == 1)
+        try await mount()
+        workspace.repairOverlay = .never
+        try await capture("accepted-removal", evidence: "real removal composition for one selected synthetic dust candidate; other candidate unchanged; no model inference")
+        editor.undo(assetID: asset.id)
+        #expect(editor.settings(for: asset.id).developGeometry.retouchStrokes.isEmpty)
+        workspace.repairOverlay = .always
+        try await mount()
+
+        try await host.press("develop.repair.mode.redEye")
+        try await host.send(.leftMouseDown, normalized: CGPoint(x: 0.38, y: 0.64))
+        try await host.send(.leftMouseDragged, normalized: CGPoint(x: 0.46, y: 0.76))
+        try await capture("red-eye-ellipse")
+        try await host.send(.leftMouseUp, normalized: CGPoint(x: 0.46, y: 0.76))
+        #expect(editor.settings(for: asset.id).developGeometry.redEyeCorrections.count == 1)
+        try await mount()
+        try await capture("red-eye-accepted")
+        editor.undo(assetID: asset.id)
+        #expect(editor.settings(for: asset.id).developGeometry.redEyeCorrections.isEmpty)
+        #expect(try Data(contentsOf: url) == bytes)
+        #expect(await editor.finishSaving())
+    }
+
+    private func wait(_ condition: () -> Bool) async throws {
+        let deadline = ContinuousClock.now + .seconds(10)
+        while !condition() { try #require(ContinuousClock.now < deadline); try await Task.sleep(for: .milliseconds(20)) }
+    }
+    private func digest(_ data: Data) -> String { SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined() }
+    private func dustCandidates() throws -> [DevelopRepairCandidate] {
+        try [(0.58, 0.35), (0.72, 0.42)].enumerated().map { index, point in
+            var cells = Data(repeating: 0, count: 90 * 60)
+            for y in 0..<60 { for x in 0..<90 {
+                if hypot((Double(x) + 0.5) / 90 - point.0, ((Double(y) + 0.5) / 60 - point.1) * 2 / 3) < 0.024 { cells[y * 90 + x] = 255 }
+            } }
+            return DevelopRepairCandidate(id: UUID(uuidString: index == 0 ? "00000000-0000-0000-0000-000000000001" : "00000000-0000-0000-0000-000000000002")!,
+                label: "Staub \(index + 1)", mask: try LocalMaskRaster(width: 90, height: 60, bytes: cells),
+                center: try LocalMaskPoint(x: point.0, y: point.1), radius: 0.045)
+        }
+    }
+    private func image() throws -> CGImage {
+        let c = try #require(CGContext(data: nil, width: 900, height: 600, bitsPerComponent: 8, bytesPerRow: 0,
+            space: CGColorSpace(name: CGColorSpace.sRGB)!, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue))
+        c.setFillColor(CGColor(srgbRed: 0.76, green: 0.77, blue: 0.68, alpha: 1)); c.fill(CGRect(x: 0, y: 0, width: 900, height: 600))
+        c.setFillColor(CGColor(srgbRed: 0.47, green: 0.52, blue: 0.40, alpha: 1)); c.fill(CGRect(x: 0, y: 0, width: 900, height: 260))
+        c.setFillColor(CGColor(srgbRed: 0.28, green: 0.37, blue: 0.27, alpha: 1)); c.fill(CGRect(x: 90, y: 60, width: 180, height: 170))
+        for p in [(0.58, 0.35), (0.72, 0.42)] {
+            c.setFillColor(CGColor(srgbRed: 0.18, green: 0.18, blue: 0.17, alpha: 1))
+            c.fillEllipse(in: CGRect(x: p.0 * 900 - 10, y: (1 - p.1) * 600 - 10, width: 20, height: 20))
+        }
+        c.setFillColor(CGColor(srgbRed: 0.84, green: 0.74, blue: 0.59, alpha: 1)); c.fillEllipse(in: CGRect(x: 290, y: 90, width: 235, height: 180))
+        c.setFillColor(CGColor(srgbRed: 0.95, green: 0.94, blue: 0.89, alpha: 1)); c.fillEllipse(in: CGRect(x: 331, y: 159, width: 92, height: 47))
+        c.setFillColor(CGColor(srgbRed: 0.81, green: 0.05, blue: 0.03, alpha: 1)); c.fillEllipse(in: CGRect(x: 360, y: 166, width: 36, height: 36))
+        return try #require(c.makeImage())
+    }
+}
+
+@MainActor
+private struct RepairAcceptanceView: View {
+    let asset: PhotoAsset
+    @ObservedObject var workspace: DevelopWorkspace
+    let bitmap: PreviewBitmap
+    let size: NSSize
+    var body: some View {
+        HStack(spacing: 0) {
+            ZStack {
+                Color(nsColor: .underPageBackgroundColor)
+                Image(decorative: bitmap.image, scale: 1).resizable().aspectRatio(contentMode: .fit)
+                DevelopCanvasInteraction(asset: asset, workspace: workspace)
+            }.frame(width: size.width - 340, height: size.height)
+            ScrollView {
+                DevelopGeometryInspector(asset: asset, workspace: workspace)
+                    .padding(.horizontal, 14).frame(width: 340)
+            }.frame(width: 340, height: size.height).background(Theme.panel)
+        }.preferredColorScheme(.dark)
+    }
+}
+
+@MainActor
+private final class RepairAcceptanceHost {
+    let window: NSWindow
+    let hosting = NSHostingView(rootView: AnyView(EmptyView()))
+    let size: NSSize
+    init(size: NSSize) {
+        self.size = size
+        _ = NSApplication.shared; WorkspaceAccessibilityElement.enableInProcess()
+        window = NSWindow(contentRect: NSRect(x: -10_000, y: -10_000, width: size.width, height: size.height), styleMask: .borderless, backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false; window.ignoresMouseEvents = true
+        window.appearance = NSAppearance(named: .darkAqua); window.contentView = hosting; window.orderBack(nil)
+    }
+    var elements: [WorkspaceAccessibilityElement] { WorkspaceAccessibilityElement.descendants(of: hosting) }
+    func mount(_ view: some View) async throws { hosting.rootView = AnyView(view); try await settle() }
+    func settle() async throws { hosting.layoutSubtreeIfNeeded(); try await Task.sleep(for: .milliseconds(100)); hosting.layoutSubtreeIfNeeded(); hosting.displayIfNeeded() }
+    func press(_ identifier: String) async throws {
+        let element = try #require(elements.first { $0.accessibilityIdentifier() == identifier }, "Missing \(identifier)")
+        try #require(element.accessibilityPerformPress()); try await settle()
+    }
+    func send(_ type: NSEvent.EventType, normalized: CGPoint) async throws {
+        var pending: [NSView] = [hosting]
+        var input: DevelopCropNativeInputView?
+        while let view = pending.popLast() {
+            if let candidate = view as? DevelopCropNativeInputView { input = candidate; break }
+            pending.append(contentsOf: view.subviews)
+        }
+        let surface = try #require(input)
+        let rect = DevelopCropCanvasPresentation.imageRect(sourceSize: CGSize(width: 900, height: 600), viewport: surface.bounds.size)
+        let location = CGPoint(x: rect.minX + rect.width * normalized.x, y: rect.minY + rect.height * normalized.y)
+        let event = try #require(NSEvent.mouseEvent(with: type, location: surface.convert(location, to: nil), modifierFlags: [],
+            timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber, context: nil, eventNumber: 0, clickCount: 1, pressure: 1))
+        switch type {
+        case .leftMouseDown: surface.mouseDown(with: event)
+        case .leftMouseDragged: surface.mouseDragged(with: event)
+        case .leftMouseUp: surface.mouseUp(with: event)
+        default: Issue.record("Unsupported event")
+        }
+        try await settle()
+    }
+    func reveal(identifier: String) async throws {
+        window.makeFirstResponder(nil)
+        try await settle()
+        let target = try #require(elements.first { $0.accessibilityIdentifier() == identifier })
+        let rect = window.convertFromScreen(target.accessibilityFrame())
+        var pending: [NSView] = [hosting]
+        while let view = pending.popLast() {
+            pending.append(contentsOf: view.subviews)
+            if let scroll = view as? NSScrollView, let document = scroll.documentView {
+                let targetRect = document.convert(rect, from: nil)
+                document.scrollToVisible(targetRect)
+                scroll.reflectScrolledClipView(scroll.contentView)
+            }
+        }
+        try await settle()
+    }
+    func snapshot(to url: URL) throws {
+        let bitmap = try #require(hosting.bitmapImageRepForCachingDisplay(in: hosting.bounds))
+        hosting.cacheDisplay(in: hosting.bounds, to: bitmap)
+        try #require(bitmap.representation(using: .png, properties: [:])).write(to: url)
+    }
+    func close() { hosting.rootView = AnyView(EmptyView()); window.close() }
+}
