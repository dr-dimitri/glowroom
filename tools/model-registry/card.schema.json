{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glowroom card v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cardVersion": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "app-pinned",
        "download-only",
        "user-import",
        "download-and-user-import"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "originalWeights": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "(unknown|[a-f0-9]{64})"
            }
          },
          "required": [
            "repository",
            "revision",
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "revision",
        "originalWeights"
      ],
      "additionalProperties": false
    },
    "licenses": {
      "type": "object",
      "properties": {
        "code": {
          "type": "object",
          "properties": {
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "declaration",
            "evidence"
          ],
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "declaration",
            "evidence"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "weights",
        "limitations"
      ],
      "additionalProperties": false
    },
    "trainingData": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "limitations",
        "evidence"
      ],
      "additionalProperties": false
    },
    "conversion": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "tools",
        "evidence"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "CoreML",
            "MLX",
            "none-download-only"
          ]
        },
        "minimumMacOS": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "computePolicy": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "enum": [
            "cpuOnly",
            "understandable-error"
          ]
        },
        "validatedCombinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "engine",
        "minimumMacOS",
        "hardware",
        "computePolicy",
        "fallback",
        "validatedCombinations",
        "limitations"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "dtype",
              "shape"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "dtype",
              "shape"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "colorSpace": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "tokenizerOrPrompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "inputs",
        "outputs",
        "normalization",
        "colorSpace",
        "resolution",
        "tokenizerOrPrompt"
      ],
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "semantic-json",
            "subject-json",
            "llm-swift",
            "sky-swift",
            "skyseg-swift",
            "user-import"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "integer",
              "const": 1
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  }
                },
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "sourceRevision": {
              "type": "string",
              "pattern": "[a-f0-9]{40}"
            },
            "weightsSHA256": {
              "type": "string",
              "pattern": "[a-f0-9]{64}"
            },
            "descriptor": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "integer",
                  "minimum": 1
                },
                "maximumTextTokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "modelID": {
                  "type": "string",
                  "minLength": 1
                },
                "normalizationVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "preprocessingVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "releaseID": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRevision": {
                  "type": "string",
                  "minLength": 1
                },
                "tokenizerVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "dimension",
                "maximumTextTokens",
                "modelID",
                "normalizationVersion",
                "preprocessingVersion",
                "releaseID",
                "sourceRevision",
                "tokenizerVersion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "files"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "referenceFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "properties": {
        "status": {
          "const": "existing-evidence-only"
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "status",
        "reports",
        "limitations"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "contains"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "cardVersion",
    "identity",
    "task",
    "status",
    "source",
    "licenses",
    "trainingData",
    "conversion",
    "runtime",
    "contract",
    "package",
    "qualification",
    "bindings"
  ],
  "additionalProperties": false
}
