@@ -0,0 +1,23 @@
+// Local evaluation variant: match the SDXL Diffusers mask-channel sampling.
+// This changes neither masked-image encoding nor the later denoise-mask blend.
+#ifndef GLOWROOM_SDXL_INPAINT_MASK_H
+#define GLOWROOM_SDXL_INPAINT_MASK_H
+
+#include "core/tensor.hpp"
+#include "model.h"
+
+namespace sd::pipeline {
+    inline sd::Tensor<float> prepare_inpaint_latent_mask(const sd::Tensor<float>& mask,
+                                                       int width, int height, int vae_scale_factor,
+                                                       SDVersion version) {
+        // Diffusers prepare_mask_latents uses torch interpolate's default
+        // nearest mode. Keep every other model's existing max reduction.
+        const auto mode = version == VERSION_SDXL_INPAINT
+                              ? sd::ops::InterpolateMode::Nearest
+                              : sd::ops::InterpolateMode::NearestMax;
+        return sd::ops::interpolate(mask,
+                                    {width / vae_scale_factor, height / vae_scale_factor, 1, 1},
+                                    mode);
+    }
+}
+#endif
